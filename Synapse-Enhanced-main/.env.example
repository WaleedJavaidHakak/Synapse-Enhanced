# --- Clerk (https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/chat
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/chat

# --- Database (MySQL). On Railway use the MySQL service's ${{MySQL.MYSQL_URL}} ---
DATABASE_URL=mysql://user:password@localhost:3306/whatsapp_clone

# --- Realtime ---
# Leave unset in production: the client connects to the same origin it was loaded from.
# NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# --- Media storage ---
# disk (default locally): files in UPLOAD_DIR (default ./public/uploads); in production point it at a persistent volume.
# database: files stored in MySQL, for hosts without a persistent disk (e.g. Render free). Default in production if UPLOAD_DIR is unset.
# UPLOAD_STORAGE=database
# UPLOAD_DIR=/data/uploads

# --- Calls: TURN relay for calls across different networks (read at call time, no rebuild needed) ---
# Option 1, Metered (free tier, auto-rotating credentials):
# METERED_DOMAIN=yourapp.metered.live
# METERED_API_KEY=
# Option 2, any TURN server with fixed credentials:
# TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=

# --- AI assist (optional) ---
AI_PROVIDER=groq
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
